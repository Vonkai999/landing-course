# Copy this file to .env and paste your Stripe TEST secret key from the Dashboard.
# Never paste a live key here while learning or share any secret key in chat.
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_key

# Local address for development. This must match the URL you use in your browser.
PUBLIC_BASE_URL=http://localhost:4242

# Fill these in only after the paid SendPulse flow is ready.
SENDPULSE_BOT_USERNAME=HighHeelsHome_bot
SENDPULSE_PAID_FLOW_ID=

# Most hosting providers set PORT automatically. Locally, the server uses 4242.
